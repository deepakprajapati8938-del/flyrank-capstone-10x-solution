# Application Settings
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
DATABASE_PATH=./incidentpulse.db

# Security & Authentication (JWT)
JWT_SECRET_KEY=super_secret_jwt_hmac_signing_key_replace_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# AI Provider Configuration ($0 / Free Tier with Deterministic Local Fallback)
GEMINI_API_KEY=your_gemini_api_key_optional
AI_MODEL_NAME=gemini-1.5-flash

# Caching & Worker
CACHE_TTL_SECONDS=300
WORKER_BATCH_SIZE=10

